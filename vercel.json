{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/email-diario.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/email-diario",
      "schedule": "30 11 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/email-diario",
      "dest": "/api/email-diario.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
